            <bpmn2:messageEventDefinition/>
        </bpmn2:endEvent>
        <bpmn2:callActivity id="CallActivity_7" name="Content Modifier 1">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>bodyType</key>
                    <value>expression</value>
                </ifl:property>
                <ifl:property>
                    <key>propertyTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>headerTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;table border="1" cellpadding="5" cellspacing="0"&gt;
&lt;tr&gt;
    &lt;th&gt;Field&lt;/th&gt;
    &lt;th&gt;Value&lt;/th&gt;
&lt;/tr&gt;
&lt;tr&gt;
    &lt;td&gt;Package&lt;/td&gt;
    &lt;td&gt;${header.packageName}&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
    &lt;td&gt;IFlow&lt;/td&gt;
    &lt;td&gt;${header.iflowName}&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
    &lt;td&gt;Message ID&lt;/td&gt;
    &lt;td&gt;${header.SAP_Main_MessageProcessingLogID}&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
    &lt;td&gt;Exception&lt;/td&gt;
    &lt;td&gt;${header.errorMessage}&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Failed Time &lt;/td&gt;
&lt;td&gt;${header.failedDateTime}&lt;/td&gt;
&lt;/table&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.6</value>
                </ifl:property>
                <ifl:property>
                    <key>activityType</key>
                    <value>Enricher</value>
                </ifl:property>
                <ifl:property>
                    <key>cmdVariantUri</key>
                    <value>ctype::FlowstepVariant/cname::Enricher/version::1.6.3</value>
                </ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SequenceFlow_3</bpmn2:incoming>
            <bpmn2:outgoing>SequenceFlow_8</bpmn2:outgoing>
        </bpmn2:callActivity>
        <bpmn2:parallelGateway id="ParallelGateway_11" name="Sequential Multicast 1">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>routingSequenceTable</key>
                    <value>&lt;row&gt;&lt;cell&gt;1&lt;/cell&gt;&lt;cell&gt;SequenceFlow_12&lt;/cell&gt;&lt;/row&gt;</value>
                </ifl:property>
                <ifl:property>
