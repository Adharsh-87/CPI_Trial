            <bpmn2:outgoing>SequenceFlow_3</bpmn2:outgoing>
            <bpmn2:messageEventDefinition/>
        </bpmn2:startEvent>
        <bpmn2:sequenceFlow id="SequenceFlow_8" sourceRef="CallActivity_7" targetRef="ParallelGateway_11"/>
        <bpmn2:sequenceFlow id="SequenceFlow_12" name="Branch 1" sourceRef="ParallelGateway_11" targetRef="EndEvent_2"/>
        <bpmn2:sequenceFlow id="SequenceFlow_3" sourceRef="StartEvent_2" targetRef="CallActivity_7"/>
    </bpmn2:process>
