            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_12" id="BPMNEdge_SequenceFlow_12" sourceElement="BPMNShape_ParallelGateway_11" targetElement="BPMNShape_EndEvent_2">
                <di:waypoint x="502.0" xsi:type="dc:Point" y="130.0"/>
                <di:waypoint x="572.0" xsi:type="dc:Point" y="130.0"/>
