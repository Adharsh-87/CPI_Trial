        <bpmn2:callActivity id="CallActivity_1" name="Content Modifier 1">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>bodyType</key>
                    <value>constant</value>
                </ifl:property>
                <ifl:property>
                    <key>propertyTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>headerTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;PurchaseOrderBatch&gt;
	&lt;Order&gt;
		&lt;OrderID&gt;PO-1001&lt;/OrderID&gt;
		&lt;Vendor&gt;Tata Steel Ltd.&lt;/Vendor&gt;
		&lt;Date&gt;2025-10-01&lt;/Date&gt;
		&lt;Currency&gt;INR&lt;/Currency&gt;
		&lt;TotalAmount&gt;250000.00&lt;/TotalAmount&gt;
		&lt;Items&gt;
			&lt;Item&gt;
				&lt;ItemNo&gt;10&lt;/ItemNo&gt;
				&lt;Material&gt;HR-COIL-5MM&lt;/Material&gt;
				&lt;Quantity&gt;500&lt;/Quantity&gt;
				&lt;Unit&gt;KG&lt;/Unit&gt;
				&lt;UnitPrice&gt;350.00&lt;/UnitPrice&gt;
			&lt;/Item&gt;
			&lt;Item&gt;
				&lt;ItemNo&gt;20&lt;/ItemNo&gt;
				&lt;Material&gt;CR-SHEET-2MM&lt;/Material&gt;
				&lt;Quantity&gt;200&lt;/Quantity&gt;
				&lt;Unit&gt;KG&lt;/Unit&gt;
				&lt;UnitPrice&gt;500.00&lt;/UnitPrice&gt;
			&lt;/Item&gt;
		&lt;/Items&gt;
	&lt;/Order&gt;
	
	&lt;Order&gt;
		&lt;OrderID&gt;PO-1002&lt;/OrderID&gt;
		&lt;Vendor&gt;Infosys BPO Pvt. Ltd.&lt;/Vendor&gt;
		&lt;Date&gt;2025-10-03&lt;/Date&gt;
		&lt;Currency&gt;INR&lt;/Currency&gt;
		&lt;TotalAmount&gt;85000.00&lt;/TotalAmount&gt;
		&lt;Items&gt;
			&lt;Item&gt;
				&lt;ItemNo&gt;10&lt;/ItemNo&gt;
				&lt;Material&gt;LAPTOP-DELL-15&lt;/Material&gt;
				&lt;Quantity&gt;5&lt;/Quantity&gt;
				&lt;Unit&gt;EA&lt;/Unit&gt;
				&lt;UnitPrice&gt;17000.00&lt;/UnitPrice&gt;
			&lt;/Item&gt;
		&lt;/Items&gt;
	&lt;/Order&gt;
	
	&lt;Order&gt;
		&lt;OrderID&gt;PO-1003&lt;/OrderID&gt;
		&lt;Vendor&gt;Wipro Logistics&lt;/Vendor&gt;
		&lt;Date&gt;2025-10-05&lt;/Date&gt;
		&lt;Currency&gt;INR&lt;/Currency&gt;
		&lt;TotalAmount&gt;12000.00&lt;/TotalAmount&gt;
		&lt;Items&gt;
			&lt;Item&gt;
				&lt;ItemNo&gt;10&lt;/ItemNo&gt;
				&lt;Material&gt;TRANSPORT-CHARGES&lt;/Material&gt;
				&lt;Quantity&gt;1&lt;/Quantity&gt;
				&lt;Unit&gt;LS&lt;/Unit&gt;
				&lt;UnitPrice&gt;12000.00&lt;/UnitPrice&gt;
			&lt;/Item&gt;
		&lt;/Items&gt;
	&lt;/Order&gt;
&lt;/PurchaseOrderBatch&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.6</value>
                </ifl:property>
                <ifl:property>
                    <key>activityType</key>
                    <value>Enricher</value>
