            <bpmndi:BPMNShape bpmnElement="StartEvent_4" id="BPMNShape_StartEvent_4">
                <dc:Bounds height="32.0" width="32.0" x="273.0" y="123.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="CallActivity_5" id="BPMNShape_CallActivity_5">
                <dc:Bounds height="60.0" width="122.0" x="442.0" y="54.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="Participant_2" id="BPMNShape_Participant_2">
                <dc:Bounds height="140.0" width="100.0" x="900.0" y="100.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="Participant_1" id="BPMNShape_Participant_1">
                <dc:Bounds height="140.0" width="100.0" x="40.0" y="100.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="Participant_Process_1" id="BPMNShape_Participant_Process_1">
                <dc:Bounds height="241.0" width="569.0" x="241.0" y="4.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_6" id="BPMNEdge_SequenceFlow_6" sourceElement="BPMNShape_StartEvent_4" targetElement="BPMNShape_CallActivity_5">
                <di:waypoint x="289.0" xsi:type="dc:Point" y="139.0"/>
                <di:waypoint x="370.75" xsi:type="dc:Point" y="139.0"/>
                <di:waypoint x="370.75" xsi:type="dc:Point" y="65.0"/>
                <di:waypoint x="499.3399963378906" xsi:type="dc:Point" y="65.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_7" id="BPMNEdge_SequenceFlow_7" sourceElement="BPMNShape_CallActivity_5" targetElement="BPMNShape_EndEvent_2">
                <di:waypoint x="563.5" xsi:type="dc:Point" y="84.0"/>
                <di:waypoint x="626.0" xsi:type="dc:Point" y="84.0"/>
                <di:waypoint x="626.0" xsi:type="dc:Point" y="122.0"/>
                <di:waypoint x="716.0" xsi:type="dc:Point" y="122.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="MessageFlow_8" id="BPMNEdge_MessageFlow_8" sourceElement="BPMNShape_Participant_1" targetElement="BPMNShape_StartEvent_4">
                <di:waypoint x="90.0" xsi:type="dc:Point" y="170.0"/>
                <di:waypoint x="289.0" xsi:type="dc:Point" y="139.0"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
