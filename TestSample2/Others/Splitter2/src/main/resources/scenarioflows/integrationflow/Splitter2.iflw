				&lt;Material&gt;CR-SHEET-2MM&lt;/Material&gt;
				&lt;Quantity&gt;200&lt;/Quantity&gt;
				&lt;Unit&gt;KG&lt;/Unit&gt;
				&lt;UnitPrice&gt;500.00&lt;/UnitPrice&gt;
			&lt;/Item&gt;
		&lt;/Items&gt;
	&lt;/Order&gt;
	
