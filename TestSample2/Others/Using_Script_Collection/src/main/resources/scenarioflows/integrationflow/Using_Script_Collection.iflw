        <bpmn2:callActivity id="CallActivity_9" name="Content Modifier 1">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>bodyType</key>
                    <value>constant</value>
                </ifl:property>
                <ifl:property>
                    <key>propertyTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>headerTable</key>
                    <value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;40000&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Salary&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;Adharsh&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Name&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;?xml version = "1.0" encoding = "UTF-8"?&gt;
&lt;root&gt;
    &lt;employee&gt;
    &lt;id&gt;1005&lt;/id&gt;
    &lt;fname&gt; Adharsh &lt;/fname&gt;
    &lt;lname&gt;Sunchu&lt;/lname&gt;
    &lt;age&gt;22&lt;/age&gt;
    &lt;address&gt; Hyderabad &lt;/address&gt;
    &lt;dob&gt;27-01-2004&lt;/dob&gt;
    &lt;/employee&gt;

    &lt;employee&gt;
    &lt;id val = "2"&gt;1002&lt;/id&gt;
     &lt;fname&gt; Rushi &lt;/fname&gt;
    &lt;lname&gt;Devarakonda&lt;/lname&gt;
    &lt;age&gt;20&lt;/age&gt;
    &lt;address&gt; HYD &lt;/address&gt;
    &lt;dob&gt;28-01-2004&lt;/dob&gt;
    &lt;/employee&gt;

    &lt;employee no ="3"&gt;
    &lt;id&gt;1003&lt;/id&gt;
     &lt;fname&gt; Rahul &lt;/fname&gt;
    &lt;lname&gt;Devarakonda&lt;/lname&gt;
    &lt;age&gt;20&lt;/age&gt;
    &lt;address&gt; HYD &lt;/address&gt;
    &lt;dob&gt;29-01-2004&lt;/dob&gt;
    &lt;/employee&gt;

    &lt;/root&gt;</value>
                </ifl:property>
